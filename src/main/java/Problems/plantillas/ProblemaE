import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.io.PrintWriter;
import java.util.StringTokenizer;

public class Main {
    static class FastScanner {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = new StringTokenizer("");

        String next() {
            while (!st.hasMoreTokens()) {
                try {
                    String line = br.readLine();
                    if (line == null) return null;
                    st = new StringTokenizer(line);
                } catch (IOException e) {
                    e.printStackTrace();
                }
            }
            return st.nextToken();
        }

        int nextInt() {
            return Integer.parseInt(next());
        }
    }

    public static void main(String[] args) {
        FastScanner sc = new FastScanner();
        PrintWriter out = new PrintWriter(System.out);

        int n = sc.nextInt();
        // 30 bits alcanzan para a_i <= 10^9 < 2^30
        PersistentTrieRangeXor trie = new PersistentTrieRangeXor(30, n);

        for (int i = 1; i <= n; i++) {
            int a = sc.nextInt();
            trie.insert(i, i - 1, a);
        }

        int q = sc.nextInt();
        for (int i = 0; i < q; i++) {
            int l = sc.nextInt();
            int r = sc.nextInt();
            int x = sc.nextInt();
            int k = sc.nextInt();

            int ans = trie.queryKthXor(l, r, x, k);
            out.println(ans);
        }

        out.flush();
        out.close();
    }
}

class PersistentTrieRangeXor {
    TrieNodeRange[] roots;
    private final int maxBits;

    public PersistentTrieRangeXor(int maxBits, int maxElements) {
        this.maxBits = maxBits;
        this.roots = new TrieNodeRange[maxElements + 2];
        this.roots[0] = new TrieNodeRange(); // Versión 0 vacía
    }

    public void insert(int version, int prevVersion, int val) {
        this.roots[version] = new TrieNodeRange(this.roots[prevVersion]);

        TrieNodeRange currOld = this.roots[prevVersion];
        TrieNodeRange currNew = this.roots[version];

        currNew.cnt++;

        for (int b = maxBits - 1; b >= 0; b--) {
            int bit = (val >> b) & 1;

            TrieNodeRange nextOld = (currOld != null) ? currOld.children[bit] : null;
            TrieNodeRange nextNew = new TrieNodeRange(nextOld);

            nextNew.cnt = (nextOld != null ? nextOld.cnt : 0) + 1;
            currNew.children[bit] = nextNew;

            currOld = nextOld;
            currNew = nextNew;
        }
    }

    public int queryKthXor(int l, int r, int x, int k) {
        TrieNodeRange nodeR = this.roots[r];
        TrieNodeRange nodeL = this.roots[l - 1];
        int ans = 0;

        for (int b = maxBits - 1; b >= 0; b--) {
            int bitX = (x >> b) & 1;
            int smallerBranch = bitX; // El camino que produce 0 en (a_i XOR x)

            int countR = (nodeR != null && nodeR.children[smallerBranch] != null) ? nodeR.children[smallerBranch].cnt : 0;
            int countL = (nodeL != null && nodeL.children[smallerBranch] != null) ? nodeL.children[smallerBranch].cnt : 0;
            int countSmaller = countR - countL;

            if (k <= countSmaller) {
                // El k-ésimo valor tiene bit 0 en la posición b
                nodeR = (nodeR != null) ? nodeR.children[smallerBranch] : null;
                nodeL = (nodeL != null) ? nodeL.children[smallerBranch] : null;
            } else {
                // El k-ésimo valor tiene bit 1 en la posición b
                k -= countSmaller;
                ans |= (1 << b);
                int largerBranch = 1 - smallerBranch;
                nodeR = (nodeR != null) ? nodeR.children[largerBranch] : null;
                nodeL = (nodeL != null) ? nodeL.children[largerBranch] : null;
            }
        }

        return ans;
    }
}

class TrieNodeRange {
    TrieNodeRange[] children;
    int cnt;

    public TrieNodeRange() {
        this.children = new TrieNodeRange[2];
        this.cnt = 0;
    }

    public TrieNodeRange(TrieNodeRange old) {
        this.children = new TrieNodeRange[2];
        if (old != null) {
            this.children[0] = old.children[0];
            this.children[1] = old.children[1];
            this.cnt = old.cnt;
        } else {
            this.cnt = 0;
        }
    }
}

